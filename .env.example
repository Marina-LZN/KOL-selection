# Pick one compatible provider.
# LLM_MODE:
# - auto: use a real model when a key exists, otherwise use labeled mock output
# - real: require a real model key and fail if the API call fails
# - mock: always use deterministic local demo output
LLM_MODE=auto

# OpenAI
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=replace_with_your_key

# DashScope / Qwen compatible mode
# LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_API_KEY=replace_with_your_key
